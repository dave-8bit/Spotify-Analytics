# ============================================================================
# Spotify Analytics — environment variable reference
# ----------------------------------------------------------------------------
# Copy this file to a real `.env` file (in `server/` for local dev) and fill in
# real values. NEVER commit real secrets. This file is a safe, committed
# reference only.
#
# All variables are server-side. The client uses relative URLs (/api, /auth,
# /socket.io) and requires no environment variables.
# ============================================================================

# --- Runtime / deployment ---
# Node environment. "development" for local dev, "production" for deployment.
# Controls cookie security (secure/sameSite) and Prisma logging.
NODE_ENV=development

# Deployment role. The single-process production target is "all" (API + worker
# schedulers in one process). "api" = HTTP only, "worker" = schedulers only.
ROLE=all

# HTTP port the Express/Socket.IO server listens on.
PORT=5000

# --- Database ---
# PostgreSQL connection string (managed Neon in production). Used by Prisma
# and the connect-pg-simple session store.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Session / auth ---
# Long random secret used to sign session cookies. Generate with e.g.
# `openssl rand -hex 32`. Must be stable across restarts.
SESSION_SECRET=change_me_to_a_long_random_secret

# --- Spotify OAuth ---
# Credentials from the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Callback URL Spotify redirects to after auth. In production this must be the
# same origin as the app, e.g. https://app.example.com/auth/spotify/callback.
SPOTIFY_REDIRECT_URI=http://localhost:5000/auth/spotify/callback

# The dashboard origin. In production set this to the app's public origin so
# CORS and OAuth state/redirects match, e.g. https://app.example.com.
FRONTEND_URL=http://localhost:5173

# --- Scheduler tuning (optional) ---
# History polling window in minutes (staggered across users). Default: 10.
HISTORY_POLL_INTERVAL_MINUTES=10

# Playback polling interval in seconds for active users. Must be an integer
# divisor of 60 between 5 and 60. Default: 30.
PLAYBACK_POLL_INTERVAL_SECONDS=30

# --- AI Insights (optional) ---
# Groq API key. Optional — the app boots and all non-AI features work without
# it; insight requests degrade gracefully when missing.
GROQ_API_KEY=your_groq_api_key_optional

# Groq model used for insight generation. Default: llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile
